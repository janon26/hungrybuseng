# Gemini API Key (100% Free Tier)
# Get your free key at: https://aistudio.google.com/app/apikey
# You can also paste your key directly in the browser UI (saved securely in localStorage)!
VITE_GEMINI_API_KEY=

# Firebase Realtime Database (Optional for Cross-Device Multiplayer Sync)
# The app supports local multi-tab sync out of the box. Connect Firebase RTDB for live mobile sync:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=

# Placeholder for Google Maps API (Optional / Reserved - app uses direct free Maps URLs)
VITE_GOOGLE_MAPS_API_KEY=
